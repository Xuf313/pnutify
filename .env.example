# Copy to .env.local for local development. Never commit real values.

# Upstash Redis (or the Vercel KV names KV_REST_API_URL / KV_REST_API_TOKEN)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Web push keys — generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services (an https URL or mailto:)
VAPID_SUBJECT=https://www.pnutify.app

# Shared secret for the cron trigger (any long random string, e.g. openssl rand -hex 32)
CRON_SECRET=

# Optional
NEXT_PUBLIC_SITE_URL=https://www.pnutify.app
# Comma-separated LAN addresses allowed to open `next dev`, e.g. 192.168.0.14
DEV_ORIGINS=

# ---------- Owner mode (optional): PLATO and NESPA for the site owner only ----------
# A long random key (openssl rand -hex 32). You type it once per device in
# Settings -> "Owner sign-in". Must be at least 32 characters. Changing it signs every device out.
OWNER_SECRET=
# Your own PLATO login. Used only on the server; never sent to any browser.
PLATO_ID=
PLATO_PW=
# Your own NESPA login (optional; without it NESPA shows deadlines but not scores).
NESPA_ID=
NESPA_PW=
